{
  "name": "codebase-observatory",
  "version": "0.4.0",
  "private": true,
  "bin": {
    "observatory": "bin/observatory.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "analyze": "node scripts/analyze-repo.mjs",
    "analyze-diff": "node scripts/analyze-diff.mjs",
    "impact": "node scripts/impact.mjs",
    "review-study": "node scripts/review-study.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/analyze-diff.test.mjs tests/impact.test.mjs tests/review-study.test.mjs && npm run build && node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.11",
    "@cloudflare/workers-types": "5.20260917.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "vinext": "1.0.0-beta.10",
    "vite": "8.3.0",
    "wrangler": "4.133.0"
  },
  "type": "module",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "license": "Apache-2.0"
}
